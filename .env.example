# Copy this file to .env and fill in real values.
# Create React App only exposes vars prefixed with REACT_APP_ to the client bundle.
# Restart `npm start` after changing any of these.

# Supabase project URL (Project Settings > API > Project URL)
REACT_APP_SUPABASE_URL=

# Supabase anon/public API key (Project Settings > API > anon public key)
REACT_APP_SUPABASE_ANON_KEY=

# Pabbly Connect webhook URL used to trigger outbound emails from Checking.jsx
REACT_APP_PABBLY_WEBHOOK_URL=

# Default "from" email address pre-filled in the email modal (optional)
REACT_APP_EMAIL_FROM=

# Default "reply-to" email address pre-filled in the email modal (optional)
REACT_APP_EMAIL_REPLY_TO=

# Port for the optional Express static server (server.js). Defaults to 5000.
PORT=5000